# Example credential variables for config/models.example.json.
# Each external model profile selects its own variable with apiKeyEnv.
# Load these into the local host environment; keys never belong in model JSON.
DEEPSEEK_API_KEY=replace-with-your-key
OPENAI_API_KEY=replace-with-your-key
# A profile may reference CODEX_API_KEY or another variable instead.
