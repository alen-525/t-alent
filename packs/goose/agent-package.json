{
  "schemaVersion": 1,
  "id": "goose",
  "name": "Goose Agent",
  "version": "0.2.0",
  "description": "Run coding tasks through the pinned Goose CLI Harness with isolated host-supplied model profiles.",
  "modelProtocols": [
    "openai-chat-completions"
  ],
  "prompts": {
    "system": "system.md",
    "protocol_openai_chat_completions": "protocol-openai-chat-completions.md",
    "task": "task.md"
  },
  "logic": {
    "adapter": "goose",
    "defaults": {},
    "steps": [
      {
        "type": "prompt",
        "ref": "system"
      },
      {
        "type": "prompt",
        "ref": "protocol_openai_chat_completions",
        "when": {
          "protocol": "openai-chat-completions"
        }
      },
      {
        "type": "prompt",
        "ref": "task"
      },
      {
        "type": "execute"
      }
    ]
  },
  "source": {
    "agent": "goose",
    "version": "1.48.0"
  }
}
