{
  "schemaVersion": 1,
  "id": "deepagents",
  "name": "Deep Agents SDK",
  "version": "0.2.0",
  "description": "Run the official Deep Agents SDK loop with LangChain OpenAI-compatible models, local workspace tools, subagents, streaming, and persistent checkpoints.",
  "modelProtocols": ["openai-chat-completions"],
  "prompts": {
    "system": "system.md",
    "protocol_openai_chat_completions": "protocol-openai-chat-completions.md",
    "task": "task.md"
  },
  "logic": {
    "adapter": "deepagents",
    "defaults": {},
    "steps": [
      { "type": "prompt", "ref": "system" },
      { "type": "prompt", "ref": "protocol_openai_chat_completions", "when": { "protocol": "openai-chat-completions" } },
      { "type": "prompt", "ref": "task" },
      { "type": "execute" }
    ]
  },
  "source": { "agent": "deepagents", "version": "0.7.21" }
}
