{
  "schemaVersion": 1,
  "id": "deepseek",
  "name": "DeepSeek Agent",
  "version": "0.2.0",
  "description": "Run coding tasks through the pinned DeepSeek Harness headless runner with host-supplied model profiles.",
  "modelProtocols": [
    "deepseek"
  ],
  "prompts": {
    "system": "system.md",
    "protocol_deepseek": "protocol-deepseek.md",
    "task": "task.md"
  },
  "logic": {
    "adapter": "deepseek",
    "defaults": {},
    "steps": [
      {
        "type": "prompt",
        "ref": "system"
      },
      {
        "type": "prompt",
        "ref": "protocol_deepseek",
        "when": {
          "protocol": "deepseek"
        }
      },
      {
        "type": "prompt",
        "ref": "task"
      },
      {
        "type": "execute"
      }
    ]
  },
  "source": {
    "agent": "deepseek",
    "version": "0.2.0-rc.2"
  }
}
