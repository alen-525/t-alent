{
  "schemaVersion": 1,
  "id": "codex",
  "name": "Codex Agent",
  "version": "0.2.0",
  "description": "Run coding tasks through the pinned Codex App Server with host-supplied model profiles.",
  "modelProtocols": [
    "openai-responses"
  ],
  "prompts": {
    "system": "system.md",
    "protocol_openai_responses": "protocol-openai-responses.md",
    "task": "task.md"
  },
  "logic": {
    "adapter": "codex",
    "defaults": {},
    "steps": [
      {
        "type": "prompt",
        "ref": "system"
      },
      {
        "type": "prompt",
        "ref": "protocol_openai_responses",
        "when": {
          "protocol": "openai-responses"
        }
      },
      {
        "type": "prompt",
        "ref": "task"
      },
      {
        "type": "execute"
      }
    ]
  },
  "source": {
    "agent": "codex",
    "version": "0.159.3"
  }
}
