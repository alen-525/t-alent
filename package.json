{
  "name": "t-alent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packs/*"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "host": "node packages/runtime/cli.mjs",
    "test:runtime": "node --test packages/runtime/*.test.mjs apps/web/src/runtime-contract.test.mjs",
    "test:pack": "npm test --workspace packs/deepseek",
    "test": "npm run test:runtime && npm run test:pack"
  },
  "dependencies": { "@vitejs/plugin-react": "^4.3.4", "vite": "^6.0.0", "typescript": "^5.7.2", "react": "^18.3.1", "react-dom": "^18.3.1", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/react": "^18.3.12", "@types/react-dom": "^18.3.1" }
}
